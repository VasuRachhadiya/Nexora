@model Nexora.Models.ExperienceItem
@{
    var related = ViewBag.Related as List<Nexora.Models.ExperienceItem> ?? new List<Nexora.Models.ExperienceItem>();
}

<!-- Case Study Hero -->
<section class="py-5 my-4 position-relative">
    <div class="container-xl px-4">
        <!-- Breadcrumb Navigation -->
        <div class="mb-4">
            <a asp-controller="Explore" asp-action="Index" class="text-secondary text-decoration-none d-inline-flex align-items-center gap-2 small">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
                <span>Back to Experiences</span>
            </a>
        </div>

        <!-- Case Study Header -->
        <div class="row g-5 align-items-end mb-5">
            <div class="col-lg-8 reveal-init">
                <span class="badge-futuristic mb-3">
                    <span class="badge-dot" style="background-color: @Model.AccentColor; box-shadow: 0 0 8px @Model.AccentColor;"></span>
                    @Model.Category
                </span>
                <h1 class="display-hero mb-3">@Model.Title</h1>
                <p class="lead-text mb-0">@Model.Subtitle</p>
            </div>

            <!-- Key Metric Box -->
            <div class="col-lg-4 reveal-init">
                <div class="glass-card p-4 text-center" style="border-color: @Model.AccentColor; box-shadow: 0 0 30px -10px @Model.AccentColor;">
                    <div class="font-mono text-muted small text-uppercase mb-1">Key Impact Achieved</div>
                    <div class="font-mono display-card text-gradient-cyan fw-bold mb-1">@Model.MetricResult</div>
                    <div class="text-secondary small">Validated via client telemetry</div>
                </div>
            </div>
        </div>

        <!-- Big Hero Visual Banner -->
        <div class="position-relative rounded-4 overflow-hidden mb-5 border border-secondary border-opacity-25 reveal-init" style="max-height: 600px; aspect-ratio: 16/9;">
            <img src="@Model.ImageUrl" alt="@Model.Title" class="w-100 h-100 object-fit-cover" />
            <div class="position-absolute inset-0" style="background: linear-gradient(180deg, transparent 60%, rgba(6,7,11,0.95) 100%);"></div>
        </div>

        <!-- Metadata Grid -->
        <div class="row g-4 mb-5">
            <div class="col-md-3 col-6 reveal-init">
                <div class="p-3 rounded-3 glass-card">
                    <div class="font-mono text-muted small text-uppercase">Client</div>
                    <div class="text-white fw-bold mt-1">@Model.Client</div>
                </div>
            </div>
            <div class="col-md-3 col-6 reveal-init">
                <div class="p-3 rounded-3 glass-card">
                    <div class="font-mono text-muted small text-uppercase">Timeline / Year</div>
                    <div class="text-white fw-bold mt-1">@Model.Year</div>
                </div>
            </div>
            <div class="col-md-3 col-6 reveal-init">
                <div class="p-3 rounded-3 glass-card">
                    <div class="font-mono text-muted small text-uppercase">Category</div>
                    <div class="text-white fw-bold mt-1">@Model.Category</div>
                </div>
            </div>
            <div class="col-md-3 col-6 reveal-init">
                <div class="p-3 rounded-3 glass-card">
                    <div class="font-mono text-muted small text-uppercase">Platform Engine</div>
                    <div class="text-gradient-purple fw-bold mt-1">ASP.NET &amp; WebGL</div>
                </div>
            </div>
        </div>

        <!-- Architectural Deep Dive Content -->
        <div class="row g-5">
            <div class="col-lg-8 reveal-init">
                <div class="glass-card p-4 p-md-5 mb-5">
                    <h3 class="text-white mb-4" style="font-size: 1.6rem;">Executive Summary &amp; Objective</h3>
                    <p class="text-secondary" style="font-size: 1.05rem; line-height: 1.8;">
                        @Model.Description
                    </p>

                    <h4 class="text-white mt-5 mb-3" style="font-size: 1.3rem;">Engineering &amp; Spatial Innovations</h4>
                    <p class="text-secondary" style="line-height: 1.8;">
                        To fulfill the rigorous latency requirements of @Model.Client, NEXORA engineered a decentralized asset streaming pipeline. Shaders were compiled with ahead-of-time GLSL optimizations, keeping memory footprints under 38 MB while delivering uncompromising 120 FPS visual fidelity.
                    </p>

                    <div class="p-4 rounded-4 my-4" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle);">
                        <h5 class="text-white mb-2" style="font-size: 1.1rem;">Full Technology Stack Deployed</h5>
                        <div class="d-flex flex-wrap gap-2 mt-3">
                            @foreach (var tech in (Model.TechStack ?? "WebGL, C#, ASP.NET Core").Split(','))
                            {
                                <span class="badge-futuristic py-1 px-3" style="text-transform: none;">
                                    <span class="badge-dot emerald"></span>
                                    @tech.Trim()
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Sidebar CTA -->
            <div class="col-lg-4 reveal-init">
                <div class="glass-card p-4 mb-4 text-center" style="background: linear-gradient(180deg, rgba(20,25,40,0.85) 0%, rgba(10,13,22,0.95) 100%);">
                    <h4 class="text-white mb-2">Commission Similar Architecture</h4>
                    <p class="text-secondary small mb-4">
                        Speak directly with Alexander Vance and our spatial engineering leads about your vision.
                    </p>
                    <a asp-controller="Home" asp-action="Contact" class="btn-nexora-primary w-100 mb-2">
                        <span>Initiate Project Inquiry</span>
                    </a>
                </div>

                <!-- Category Related Links -->
                @if (related.Any())
                {
                    <div class="glass-card p-4">
                        <h5 class="text-white mb-3" style="font-size: 1.1rem;">Related In @Model.Category</h5>
                        <div class="d-flex flex-column gap-3">
                            @foreach (var rel in related)
                            {
                                <a asp-action="Details" asp-route-id="@rel.Id" class="text-decoration-none p-2 rounded-3" style="background: rgba(255,255,255,0.02); transition: var(--transition-fast);">
                                    <div class="text-white fw-semibold small">@rel.Title</div>
                                    <div class="font-mono text-muted" style="font-size: 0.72rem;">@rel.Client • @rel.MetricResult</div>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>
