@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var isAdmin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "NEXORA") — Premium Futuristic Digital Experience</title>
    <meta name="description" content="NEXORA is an award-winning creative engineering studio architecting cinematic digital products, spatial interfaces, and high-performance Web systems." />
    
    <!-- Open Graph Metadata -->
    <meta property="og:title" content="NEXORA — Premium Modern Web Experience" />
    <meta property="og:description" content="Ideas deserve extraordinary experiences. High-performance design & spatial digital products." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap & Site CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Ambient Lighting Mesh & Interactive Particle Canvas -->
    <div class="ambient-mesh" aria-hidden="true">
        <div class="ambient-orb ambient-orb-1"></div>
        <div class="ambient-orb ambient-orb-2"></div>
        <div class="ambient-orb ambient-orb-3"></div>
    </div>
    <canvas id="particle-canvas" aria-hidden="true"></canvas>

    <!-- App Wrapper -->
    <div class="app-content">
        <!-- Floating Glassmorphic Navigation -->
        <header>
            <nav class="nexora-navbar">
                <div class="navbar-inner">
                    <!-- Brand -->
                    <a class="navbar-brand-logo" asp-controller="Home" asp-action="Index">
                        <div class="brand-icon-gem">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 17 12 22 22 17"></polyline>
                                <polyline points="2 12 12 17 22 12"></polyline>
                            </svg>
                        </div>
                        <span>NEXORA</span>
                    </a>

                    <!-- Nav Items Cluster -->
                    <ul class="nav-links-cluster">
                        <li>
                            <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" 
                               asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li>
                            <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Explore" ? "active" : "")" 
                               asp-controller="Explore" asp-action="Index">Explore</a>
                        </li>
                        <li>
                            <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Services" ? "active" : "")" 
                               asp-controller="Services" asp-action="Index">Services</a>
                        </li>
                        <li>
                            <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" 
                               asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li>
                            <a class="nav-link-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")" 
                               asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>

                    <!-- Actions Cluster -->
                    <div class="nav-actions-cluster">
                        <!-- Search Trigger Button -->
                        <button type="button" class="btn-nexora-icon" data-open-search title="Search experiences (Ctrl+K)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </button>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="dropdown">
                                <button class="btn-nexora-secondary py-1 px-3 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="badge-dot emerald"></span>
                                    <span style="font-size: 0.88rem;">@(currentUser?.FullName ?? User.Identity?.Name)</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end p-2" style="background: rgba(14, 18, 28, 0.95); border: 1px solid var(--border-subtle); backdrop-filter: blur(16px); border-radius: 12px;">
                                    @if (isAdmin)
                                    {
                                        <li>
                                            <a class="dropdown-item rounded py-2 text-warning fw-semibold d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                                                Admin Dashboard
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider border-secondary my-1"></li>
                                    }
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item rounded py-2 text-danger d-flex align-items-center gap-2">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                                Sign Out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn-nexora-ghost d-none d-sm-inline-flex" asp-controller="Account" asp-action="Login">Sign In</a>
                            <a class="btn-nexora-primary" asp-controller="Home" asp-action="Contact">
                                <span>Get Started</span>
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </a>
                        }

                        <!-- Mobile Hamburger Button -->
                        <button type="button" class="mobile-nav-toggle" aria-label="Toggle Navigation">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="3" y1="12" x2="21" y2="12"></line>
                                <line x1="3" y1="6" x2="21" y2="6"></line>
                                <line x1="3" y1="18" x2="21" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Mobile Navigation Drawer Overlay -->
        <div class="mobile-drawer-overlay">
            <div class="mobile-drawer">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="navbar-brand-logo">
                            <div class="brand-icon-gem">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                </svg>
                            </div>
                            <span>NEXORA</span>
                        </div>
                        <button type="button" class="mobile-drawer-close btn-nexora-icon" aria-label="Close menu">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                    <div class="mobile-drawer-links">
                        <a class="mobile-drawer-link" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="mobile-drawer-link" asp-controller="Explore" asp-action="Index">Explore</a>
                        <a class="mobile-drawer-link" asp-controller="Services" asp-action="Index">Services</a>
                        <a class="mobile-drawer-link" asp-controller="Home" asp-action="About">About Studio</a>
                        <a class="mobile-drawer-link" asp-controller="Home" asp-action="Contact">Contact</a>
                        <a class="mobile-drawer-link" asp-controller="Search" asp-action="Index">Global Search</a>
                        @if (isAdmin)
                        {
                            <a class="mobile-drawer-link text-warning" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Portal</a>
                        }
                    </div>
                </div>

                <div class="mt-4 pt-4 border-top border-secondary border-opacity-25">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="text-secondary small mb-3">Signed in as <strong class="text-white">@User.Identity?.Name</strong></div>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-nexora-secondary w-100 justify-content-center">Sign Out</button>
                        </form>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            <a class="btn-nexora-secondary w-100 justify-content-center" asp-controller="Account" asp-action="Login">Sign In</a>
                            <a class="btn-nexora-primary w-100 justify-content-center" asp-controller="Account" asp-action="Register">Join NEXORA</a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Global Search Dialog Modal (Ctrl + K) -->
        <div class="nexora-search-modal" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
            <div class="search-dialog-box">
                <form asp-controller="Search" asp-action="Index" method="get">
                    <div class="search-input-header">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--primary-light)" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input id="search-modal-input" name="q" type="text" class="search-input-field" 
                               placeholder="Search experiences, spatial platforms, AI interfaces..." autocomplete="off" />
                        <button type="button" class="btn-nexora-icon" data-close-search aria-label="Close search">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="18" y1="6" x2="6" y2="18"></line>
                                <line x1="6" y1="6" x2="18" y2="18"></line>
                            </svg>
                        </button>
                    </div>
                    <div class="p-3 d-flex flex-wrap align-items-center justify-content-between gap-2" style="background: rgba(255,255,255,0.02); font-size: 0.82rem; color: var(--text-muted);">
                        <div class="d-flex gap-2 align-items-center">
                            <span>Popular:</span>
                            <a asp-controller="Explore" asp-action="Index" asp-route-category="AI & Spatial" class="badge-futuristic py-1 px-2" style="text-transform:none;">AI & Spatial</a>
                            <a asp-controller="Explore" asp-action="Index" asp-route-category="Fintech Platform" class="badge-futuristic py-1 px-2" style="text-transform:none;">Fintech</a>
                            <a asp-controller="Services" asp-action="Index" class="badge-futuristic py-1 px-2" style="text-transform:none;">Design Systems</a>
                        </div>
                        <div class="d-none d-sm-block">Press <kbd class="px-2 py-1 rounded" style="background: rgba(255,255,255,0.08); color: var(--text-secondary); border: 1px solid var(--border-subtle);">ESC</kbd> to exit</div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Main Page Content Body -->
        <main role="main">
            @RenderBody()
        </main>

        <!-- Cinematic Footer -->
        <footer class="nexora-footer">
            <div class="container-xl px-4">
                <div class="row g-5 mb-5">
                    <!-- Brand Column -->
                    <div class="col-lg-4 col-md-6">
                        <div class="navbar-brand-logo mb-3">
                            <div class="brand-icon-gem">
                                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                                    <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                    <polyline points="2 17 12 22 22 17"></polyline>
                                    <polyline points="2 12 12 17 22 12"></polyline>
                                </svg>
                            </div>
                            <span>NEXORA</span>
                        </div>
                        <p class="text-secondary small mb-4" style="line-height: 1.7; max-width: 340px;">
                            Architecting the next era of digital experiences. We bridge human perception, spatial computing, and high-performance Web architecture for category-defining products.
                        </p>
                        <div class="d-inline-flex align-items-center gap-2 py-1 px-3 rounded-pill" style="background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.25);">
                            <span class="badge-dot emerald"></span>
                            <span style="font-size: 0.78rem; font-family: var(--font-mono); color: #34d399;">All Systems Operational • 14ms Edge Latency</span>
                        </div>
                    </div>

                    <!-- Navigation Links Column -->
                    <div class="col-lg-2 col-md-6 col-6">
                        <h6 class="text-white text-uppercase font-mono mb-3" style="font-size: 0.8rem; letter-spacing: 0.08em;">Studio</h6>
                        <a class="footer-link" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="footer-link" asp-controller="Explore" asp-action="Index">Explore Portfolio</a>
                        <a class="footer-link" asp-controller="Services" asp-action="Index">Services & Strategy</a>
                        <a class="footer-link" asp-controller="Home" asp-action="About">About NEXORA</a>
                        <a class="footer-link" asp-controller="Home" asp-action="Contact">Initiate Project</a>
                    </div>

                    <!-- Technology Links Column -->
                    <div class="col-lg-2 col-md-6 col-6">
                        <h6 class="text-white text-uppercase font-mono mb-3" style="font-size: 0.8rem; letter-spacing: 0.08em;">Capability</h6>
                        <span class="footer-link text-muted">Spatial WebXR</span>
                        <span class="footer-link text-muted">WebGL 2.0 Shaders</span>
                        <span class="footer-link text-muted">ASP.NET Core .NET 10</span>
                        <span class="footer-link text-muted">Entity Framework Core</span>
                        <span class="footer-link text-muted">Cryptographic Systems</span>
                    </div>

                    <!-- Newsletter Column -->
                    <div class="col-lg-4 col-md-6">
                        <h6 class="text-white text-uppercase font-mono mb-3" style="font-size: 0.8rem; letter-spacing: 0.08em;">NEXORA Insider Dispatch</h6>
                        <p class="text-secondary small mb-3">
                            Receive confidential design drops, spatial computing blueprints, and engineering breakthroughs directly to your inbox.
                        </p>
                        <form class="newsletter-ajax-form d-flex gap-2">
                            <input type="email" required placeholder="Enter work email address..." class="form-control-nexora py-2" style="border-radius: var(--radius-pill); font-size: 0.88rem;" />
                            <button type="submit" class="btn-nexora-primary py-2 px-3 flex-shrink-0" style="font-size: 0.88rem;">
                                Subscribe
                            </button>
                        </form>
                        <div class="d-flex gap-3 mt-4">
                            <a href="#" class="btn-nexora-icon" title="Twitter / X" aria-label="X Twitter">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                            </a>
                            <a href="#" class="btn-nexora-icon" title="GitHub" aria-label="GitHub">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                            </a>
                            <a href="#" class="btn-nexora-icon" title="LinkedIn" aria-label="LinkedIn">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Legal Subfooter -->
                <div class="pt-4 border-top border-secondary border-opacity-15 d-flex flex-wrap align-items-center justify-content-between gap-3 text-secondary small">
                    <div>
                        &copy; 2026 NEXORA Digital Systems Inc. All rights reserved. Built with ASP.NET Core &amp; EF Core.
                    </div>
                    <div class="d-flex gap-4">
                        <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none hover-white">Privacy Policy</a>
                        <a asp-controller="Home" asp-action="Terms" class="text-secondary text-decoration-none hover-white">Terms of Experience</a>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-muted text-decoration-none hover-white">Staff Portal</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
