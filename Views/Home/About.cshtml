@{
    ViewData["Title"] = "About Studio — The Architecture of Intent";
}

<!-- About Studio Hero -->
<section class="py-5 my-4 position-relative">
    <div class="container-xl px-4">
        <div class="max-w-800 mx-auto text-center mb-5 reveal-init">
            <span class="badge-futuristic mb-3">
                <span class="badge-dot"></span>
                Creative Engineering Collective
            </span>
            <h1 class="display-hero mb-4">
                Pioneering The <br />
                <span class="text-gradient-purple">Spatial Era</span> Of Web.
            </h1>
            <p class="lead-text mx-auto" style="max-width: 680px;">
                NEXORA was founded on a singular conviction: as screens evolve into spatial computing, the Web must transform from static rectangles into living, cinematic environments.
            </p>
        </div>

        <!-- Vision Manifesto Cards -->
        <div class="row g-4 my-5">
            <div class="col-lg-4 col-md-6 reveal-init">
                <div class="glass-card h-100">
                    <span class="font-mono text-gradient-purple fw-bold d-block mb-3">01 / PHILOSOPHY</span>
                    <h3 class="text-white mb-3" style="font-size: 1.45rem;">Zero Generic UI</h3>
                    <p class="text-secondary small" style="line-height: 1.7;">
                        Cookie-cutter templates and generic components kill brand equity. Every NEXORA artifact is drawn from bespoke design tokens, custom WebGL shaders, and handcrafted typography.
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 reveal-init">
                <div class="glass-card h-100">
                    <span class="font-mono text-gradient-cyan fw-bold d-block mb-3">02 / CRAFT</span>
                    <h3 class="text-white mb-3" style="font-size: 1.45rem;">Kinetic Ergonomics</h3>
                    <p class="text-secondary small" style="line-height: 1.7;">
                        Micro-interactions must feel like organic physics, not robotic keyframes. We measure motion curves down to the millisecond to ensure fluid cognitive delight.
                    </p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6 reveal-init">
                <div class="glass-card h-100">
                    <span class="font-mono text-white fw-bold d-block mb-3">03 / ARCHITECTURE</span>
                    <h3 class="text-white mb-3" style="font-size: 1.45rem;">C# &amp; EF Core Engine</h3>
                    <p class="text-secondary small" style="line-height: 1.7;">
                        Beneath stunning visuals lies rock-solid Microsoft .NET architecture. Zero runtime crashes, sub-millisecond database queries, and resilient decentralized cloud orchestration.
                    </p>
                </div>
            </div>
        </div>

        <!-- Studio Leadership Team -->
        <div class="my-5 py-5 border-top border-secondary border-opacity-15">
            <div class="text-center mb-5 reveal-init">
                <span class="badge-futuristic mb-3">
                    <span class="badge-dot emerald"></span>
                    Minds Behind NEXORA
                </span>
                <h2 class="display-section mb-3">Studio <span class="text-gradient-cyan">Leadership.</span></h2>
                <p class="lead-text mx-auto" style="max-width: 600px;">
                    A rare blend of visionary creative directors, spatial computing mathematicians, and enterprise systems architects.
                </p>
            </div>

            <div class="row g-4">
                <!-- Leader 1 -->
                <div class="col-lg-3 col-sm-6 reveal-init">
                    <div class="glass-card text-center p-4 h-100" data-tilt>
                        <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=350&q=80" 
                             alt="Alexander Vance" class="rounded-circle mb-3 border border-2 border-primary" 
                             style="width: 110px; height: 110px; object-fit: cover; box-shadow: 0 0 20px -3px var(--primary-glow);" />
                        <h4 class="text-white mb-1" style="font-size: 1.25rem;">Alexander Vance</h4>
                        <div class="font-mono small text-gradient-purple mb-3">Executive Design Director</div>
                        <p class="text-secondary small mb-0">Former Head of Spatial Design at Apple Vision Pro partner studios. 14x Awwwards Winner.</p>
                    </div>
                </div>

                <!-- Leader 2 -->
                <div class="col-lg-3 col-sm-6 reveal-init">
                    <div class="glass-card text-center p-4 h-100" data-tilt>
                        <img src="https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=350&q=80" 
                             alt="Elena Rostova" class="rounded-circle mb-3 border border-2" 
                             style="width: 110px; height: 110px; object-fit: cover; border-color: var(--accent-cyan); box-shadow: 0 0 20px -3px var(--accent-cyan-glow);" />
                        <h4 class="text-white mb-1" style="font-size: 1.25rem;">Elena Rostova</h4>
                        <div class="font-mono small text-gradient-cyan mb-3">Chief Spatial Engineer</div>
                        <p class="text-secondary small mb-0">Specializes in GPU shader compilation, WebGL 2.0 physics, and real-time volumetric streaming.</p>
                    </div>
                </div>

                <!-- Leader 3 -->
                <div class="col-lg-3 col-sm-6 reveal-init">
                    <div class="glass-card text-center p-4 h-100" data-tilt>
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=350&q=80" 
                             alt="Marcus Thorne" class="rounded-circle mb-3 border border-2" 
                             style="width: 110px; height: 110px; object-fit: cover; border-color: #3b82f6; box-shadow: 0 0 20px -3px rgba(59,130,246,0.4);" />
                        <h4 class="text-white mb-1" style="font-size: 1.25rem;">Marcus Thorne</h4>
                        <div class="font-mono small text-white mb-3">VP of Systems Engineering</div>
                        <p class="text-secondary small mb-0">Architected high-throughput financial telemetries handling $20B+ daily volume across .NET backends.</p>
                    </div>
                </div>

                <!-- Leader 4 -->
                <div class="col-lg-3 col-sm-6 reveal-init">
                    <div class="glass-card text-center p-4 h-100" data-tilt>
                        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=350&q=80" 
                             alt="Kaori Tanaka" class="rounded-circle mb-3 border border-2 border-warning" 
                             style="width: 110px; height: 110px; object-fit: cover; box-shadow: 0 0 20px -3px rgba(245,158,11,0.4);" />
                        <h4 class="text-white mb-1" style="font-size: 1.25rem;">Kaori Tanaka</h4>
                        <div class="font-mono small text-gradient-amber mb-3">Director of AI Interactions</div>
                        <p class="text-secondary small mb-0">Pioneered cognitive generative interfaces and contextual human-AI micro-workflows in Tokyo &amp; SF.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Milestones Timeline -->
        <div class="my-5 py-5 border-top border-secondary border-opacity-15">
            <div class="text-center mb-5 reveal-init">
                <span class="badge-futuristic mb-3">
                    <span class="badge-dot"></span>
                    Trajectory &amp; Impact
                </span>
                <h2 class="display-section mb-3">Studio <span class="text-gradient-purple">Milestones.</span></h2>
            </div>

            <div class="row g-4 justify-content-center">
                <div class="col-lg-8">
                    <div class="p-4 rounded-4 mb-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle);">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="font-mono text-gradient-purple fw-bold">2026 — Present</span>
                            <span class="badge-futuristic py-1 px-2" style="font-size: 0.7rem;">Spatial Web Era</span>
                        </div>
                        <h4 class="text-white mb-2">Launch of NEXORA Neural Engine</h4>
                        <p class="text-secondary small mb-0">
                            Pioneered real-time 3D volumetric ray-tracing inside Web browsers at zero latency, powering spatial computing apps for Fortune 50 clients.
                        </p>
                    </div>

                    <div class="p-4 rounded-4 mb-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle);">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="font-mono text-gradient-cyan fw-bold">2025</span>
                            <span class="badge-futuristic py-1 px-2" style="font-size: 0.7rem;">Global Expansion</span>
                        </div>
                        <h4 class="text-white mb-2">Awwwards Studio of the Year Nominee</h4>
                        <p class="text-secondary small mb-0">
                            Expanded creative hubs to Tokyo and London. Surpassed $100M+ in collective client valuation increases driven by NEXORA product launches.
                        </p>
                    </div>

                    <div class="p-4 rounded-4" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle);">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="font-mono text-white fw-bold">2023 — 2024</span>
                            <span class="badge-futuristic py-1 px-2" style="font-size: 0.7rem;">Genesis</span>
                        </div>
                        <h4 class="text-white mb-2">Foundation of NEXORA Labs</h4>
                        <p class="text-secondary small mb-0">
                            Established by senior engineering directors from Silicon Valley and Tokyo to bridge enterprise C# reliability with high-fashion digital art direction.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Call to Action Banner -->
        <div class="text-center py-5">
            <h2 class="display-card text-white mb-4">Ready to Collaborate with Our Directors?</h2>
            <a asp-controller="Home" asp-action="Contact" class="btn-nexora-primary">
                <span>Start a Conversation</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
        </div>
    </div>
</section>
