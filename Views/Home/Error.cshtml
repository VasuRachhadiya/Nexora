@model ErrorViewModel
@{
    ViewData["Title"] = "Error — Anomaly Detected";
}

<section class="py-5 my-5 text-center">
    <div class="container-xl px-4">
        <div class="glass-card max-w-600 mx-auto p-5" style="border-color: rgba(244, 63, 94, 0.4);">
            <div class="badge-dot" style="background-color: #f43f5e; box-shadow: 0 0 12px #f43f5e; width: 12px; height: 12px; margin: 0 auto 1.5rem auto;"></div>
            <h1 class="display-section text-white mb-3">Anomaly Detected</h1>
            <p class="lead-text mb-4">
                The requested digital coordinate could not be resolved or experienced an unexpected state.
            </p>
            @if (Model?.ShowRequestId ?? false)
            {
                <div class="p-3 rounded-3 mb-4 font-mono small text-secondary" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-subtle);">
                    <strong>Diagnostic Trace ID:</strong> <code>@Model.RequestId</code>
                </div>
            }
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn-nexora-primary">
                    <span>Return to Nexus</span>
                </a>
                <a asp-controller="Home" asp-action="Contact" class="btn-nexora-secondary">
                    <span>Report Anomaly</span>
                </a>
            </div>
        </div>
    </div>
</section>
