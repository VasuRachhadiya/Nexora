@{
    ViewData["Title"] = "Privacy Policy — Digital Telemetry & Security";
}

<section class="py-5 my-4">
    <div class="container-xl px-4">
        <div class="max-w-800 mx-auto">
            <span class="badge-futuristic mb-3">
                <span class="badge-dot emerald"></span>
                Security Architecture
            </span>
            <h1 class="display-section mb-4">Privacy <span class="text-gradient-purple">Policy.</span></h1>
            <p class="text-secondary small font-mono mb-5">Effective Date: November 24, 2026 • Version 3.4 Cryptographic Edition</p>

            <div class="glass-card p-4 p-md-5 mb-4">
                <h3 class="text-white mb-3" style="font-size: 1.35rem;">1. Data Philosophy &amp; Minimal Telemetry</h3>
                <p class="text-secondary small" style="line-height: 1.8;">
                    NEXORA Digital Systems Inc. (&ldquo;NEXORA&rdquo;) operates on zero-surveillance design principles. We believe digital telemetry should serve human cognitive enhancement, not invasive data brokering. We only collect information strictly required to orchestrate our spatial experiences and contact transmissions.
                </p>

                <h3 class="text-white mt-4 mb-3" style="font-size: 1.35rem;">2. Information We Process</h3>
                <ul class="text-secondary small ps-3 mb-4" style="line-height: 1.8;">
                    <li><strong>Direct Inquiries:</strong> When you submit our project contact form, we store your name, email address, organization category, and message in our encrypted SQL database.</li>
                    <li><strong>Insider Dispatch:</strong> Subscribers to our newsletter have their verified email address stored with cryptographic hash verification to prevent duplication.</li>
                    <li><strong>Spatial Performance Telemetry:</strong> Anonymous frame-rate metrics (FPS), WebGL capability flags, and Core Web Vitals to optimize rendering shaders across diverse hardware.</li>
                </ul>

                <h3 class="text-white mt-4 mb-3" style="font-size: 1.35rem;">3. Cryptographic Storage &amp; Infrastructure</h3>
                <p class="text-secondary small" style="line-height: 1.8;">
                    All database operations are conducted via Microsoft Entity Framework Core with parameterized queries, preventing SQL injection vulnerabilities. Connections utilize TLS 1.3 encryption with strict Transport Layer Security headers (HSTS).
                </p>

                <h3 class="text-white mt-4 mb-3" style="font-size: 1.35rem;">4. Your Rights &amp; Data Erasure</h3>
                <p class="text-secondary small mb-0" style="line-height: 1.8;">
                    You retain absolute ownership over your transmitted data. To request immediate complete deletion of your contact records or newsletter subscriptions, dispatch an erasure request to <a href="mailto:privacy@nexora.studio" class="text-gradient-cyan text-decoration-none">privacy@nexora.studio</a>.
                </p>
            </div>
        </div>
    </div>
</section>
