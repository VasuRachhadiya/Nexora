@model Nexora.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Authenticate — NEXORA Studio";
}

<section class="py-5 my-5">
    <div class="container-xl px-4">
        <div class="max-w-500 mx-auto">
            <div class="text-center mb-4 reveal-init">
                <span class="badge-futuristic mb-3">
                    <span class="badge-dot"></span>
                    Secure Access
                </span>
                <h1 class="display-section mb-2">Welcome <span class="text-gradient-purple">Back.</span></h1>
                <p class="text-secondary small">Access confidential project telemetries and administrative controls.</p>
            </div>

            <!-- Login Glass Card -->
            <div class="glass-card p-4 p-md-5 reveal-init">
                <!-- Demo Credentials Helper Pill -->
                <div class="p-3 rounded-3 mb-4" style="background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.3);">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="font-mono text-gradient-purple small fw-bold">Admin Demo Credentials</span>
                        <span class="badge-dot emerald"></span>
                    </div>
                    <div class="font-mono text-secondary small" style="font-size: 0.8rem;">
                        Email: <strong class="text-white">admin@nexora.studio</strong><br />
                        Password: <strong class="text-white">Nexora@2026!</strong>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label-nexora"></label>
                        <input asp-for="Email" type="email" class="form-control-nexora" placeholder="director@nexora.studio" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label asp-for="Password" class="form-label-nexora mb-0"></label>
                        </div>
                        <input asp-for="Password" type="password" class="form-control-nexora" placeholder="••••••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" style="background-color: rgba(255,255,255,0.08); border-color: var(--border-subtle);" />
                            <label asp-for="RememberMe" class="form-check-label text-secondary small"></label>
                        </div>
                    </div>

                    <button type="submit" class="btn-nexora-primary w-100 py-3 mb-4" style="font-size: 1rem;">
                        <span>Authenticate Device</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>

                    <div class="text-center text-secondary small">
                        New to NEXORA? 
                        <a asp-controller="Account" asp-action="Register" class="text-gradient-cyan text-decoration-none fw-semibold">
                            Create Account
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
