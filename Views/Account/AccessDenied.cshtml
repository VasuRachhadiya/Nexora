@{
    ViewData["Title"] = "Access Restricted";
}

<section class="py-5 my-5 text-center">
    <div class="container-xl px-4">
        <div class="glass-card max-w-600 mx-auto p-5" style="border-color: rgba(245, 158, 11, 0.4);">
            <div class="badge-dot" style="background-color: #f59e0b; box-shadow: 0 0 12px #f59e0b; width: 12px; height: 12px; margin: 0 auto 1.5rem auto;"></div>
            <h1 class="display-section text-white mb-3">Clearance Required</h1>
            <p class="lead-text mb-4">
                This administrative corridor requires Executive Director clearance. Please authenticate with an authorized administrator account.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Account" asp-action="Login" class="btn-nexora-primary">
                    <span>Switch Account</span>
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn-nexora-secondary">
                    <span>Return to Nexus</span>
                </a>
            </div>
        </div>
    </div>
</section>
