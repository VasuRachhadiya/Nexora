@model Nexora.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account — Join NEXORA";
}

<section class="py-5 my-5">
    <div class="container-xl px-4">
        <div class="max-w-500 mx-auto">
            <div class="text-center mb-4 reveal-init">
                <span class="badge-futuristic mb-3">
                    <span class="badge-dot cyan"></span>
                    Membership Registration
                </span>
                <h1 class="display-section mb-2">Join <span class="text-gradient-cyan">NEXORA.</span></h1>
                <p class="text-secondary small">Gain priority access to private spatial beta drops and case study blueprints.</p>
            </div>

            <!-- Register Glass Card -->
            <div class="glass-card p-4 p-md-5 reveal-init">
                <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label-nexora"></label>
                        <input asp-for="FullName" class="form-control-nexora" placeholder="Julian Croft" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label-nexora"></label>
                        <input asp-for="Email" type="email" class="form-control-nexora" placeholder="julian@enterprise.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label-nexora"></label>
                        <input asp-for="Password" type="password" class="form-control-nexora" placeholder="Minimum 8 characters" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label-nexora"></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control-nexora" placeholder="Repeat password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="AcceptTerms" class="form-check-input" style="background-color: rgba(255,255,255,0.08); border-color: var(--border-subtle);" />
                            <label asp-for="AcceptTerms" class="form-check-label text-secondary small">
                                I accept the <a asp-controller="Home" asp-action="Terms" class="text-white text-decoration-none">Terms of Experience</a> and <a asp-controller="Home" asp-action="Privacy" class="text-white text-decoration-none">Privacy Policy</a>
                            </label>
                        </div>
                        <span asp-validation-for="AcceptTerms" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn-nexora-primary w-100 py-3 mb-4" style="font-size: 1rem;">
                        <span>Complete Registration</span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
                    </button>

                    <div class="text-center text-secondary small">
                        Already have an account? 
                        <a asp-controller="Account" asp-action="Login" class="text-gradient-purple text-decoration-none fw-semibold">
                            Sign In
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
