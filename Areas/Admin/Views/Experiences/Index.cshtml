@model List<Nexora.Models.ExperienceItem>
@{
    ViewData["Title"] = "Experience Showcase Management";
}

<div class="mb-5 d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div>
        <h1 class="display-section mb-1">Showcase <span class="text-gradient-purple">Artifacts.</span></h1>
        <p class="text-secondary small mb-0">Create, curate, and configure public portfolio experiences.</p>
    </div>
    <a asp-action="Create" class="btn-nexora-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        <span>Add Artifact</span>
    </a>
</div>

<div class="glass-card p-4">
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Visual</th>
                    <th>Artifact Details</th>
                    <th>Category</th>
                    <th>Client / Year</th>
                    <th>Metric</th>
                    <th>Featured</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exp in Model)
                {
                    <tr>
                        <td style="width: 80px;">
                            <img src="@exp.ImageUrl" alt="@exp.Title" class="rounded-2" style="width: 70px; height: 50px; object-fit: cover;" />
                        </td>
                        <td>
                            <div class="fw-bold text-white">@exp.Title</div>
                            <div class="text-secondary small text-truncate" style="max-width: 250px;">@exp.Subtitle</div>
                        </td>
                        <td>
                            <span class="badge-futuristic py-1 px-2" style="font-size: 0.72rem;">@exp.Category</span>
                        </td>
                        <td class="font-mono text-muted small">
                            @exp.Client (@exp.Year)
                        </td>
                        <td class="font-mono text-gradient-cyan small fw-bold">
                            @exp.MetricResult
                        </td>
                        <td>
                            @if (exp.IsFeatured)
                            {
                                <span class="badge-dot emerald" title="Featured on Homepage"></span>
                            }
                            else
                            {
                                <span class="badge-dot" style="background:#475569;" title="Standard"></span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@exp.Id" class="btn-nexora-secondary py-1 px-3" style="font-size: 0.8rem;">
                                    Edit
                                </a>
                                <form asp-action="Delete" asp-route-id="@exp.Id" method="post" onsubmit="return confirm('Remove this experience artifact?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-nexora-icon" style="width: 32px; height: 32px; color: #f43f5e;" title="Delete">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
