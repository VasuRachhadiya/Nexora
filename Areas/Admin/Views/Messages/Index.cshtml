@model List<Nexora.Models.ContactMessage>
@{
    ViewData["Title"] = "Inquiry Telemetry & Communications";
}

<div class="mb-5 d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div>
        <h1 class="display-section mb-1">Inquiry <span class="text-gradient-cyan">Transmissions.</span></h1>
        <p class="text-secondary small mb-0">Project inquiries submitted via public dispatch interfaces.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn-nexora-secondary @(ViewBag.UnreadOnly != true ? "border-primary text-white" : "")">All Dispatches</a>
        <a asp-action="Index" asp-route-unreadOnly="true" class="btn-nexora-secondary @(ViewBag.UnreadOnly == true ? "border-primary text-white" : "")">Unread Only</a>
    </div>
</div>

<div class="glass-card p-4">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="badge-dot emerald mb-3 mx-auto"></div>
            <h5 class="text-white mb-2">Inbox Clear</h5>
            <p class="text-secondary small">No inquiries match the current filter.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Sender</th>
                        <th>Category</th>
                        <th>Subject</th>
                        <th>Received Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Model)
                    {
                        <tr>
                            <td>
                                @if (!msg.IsRead)
                                {
                                    <span class="badge-dot" style="background: #06b6d4; box-shadow: 0 0 8px #06b6d4;" title="Unread"></span>
                                }
                                else
                                {
                                    <span class="badge-dot" style="background: #475569;" title="Read"></span>
                                }
                            </td>
                            <td>
                                <div class="fw-bold text-white">@msg.Name</div>
                                <div class="font-mono text-muted small">@msg.Email</div>
                            </td>
                            <td>
                                <span class="badge-futuristic py-1 px-2" style="font-size: 0.72rem;">@msg.Category</span>
                            </td>
                            <td class="text-secondary small">
                                @(msg.Subject ?? "No Subject Provided")
                            </td>
                            <td class="font-mono text-muted small">
                                @msg.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@msg.Id" class="btn-nexora-secondary py-1 px-3" style="font-size: 0.8rem;">
                                        Read
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@msg.Id" method="post" onsubmit="return confirm('Permanently delete this dispatch?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-nexora-icon" style="width: 32px; height: 32px; color: #f43f5e;" title="Delete">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
